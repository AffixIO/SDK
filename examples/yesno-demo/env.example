# Required. Your Hub licence key (trial or paid).
AFFIX_API_KEY=aio_live_your_key_here

# AffixIO API (default shown).
AFFIX_API_BASE=https://api.affix-io.com

# Optional. Shared HMAC secret if you copy proofs between machines.
AFFIX_LOCAL_HMAC_SECRET=affix-demo-local-hmac-secret

# Server port (default 3847).
PORT=3847
