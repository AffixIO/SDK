{
  "name": "affixio",
  "version": "1.3.3",
  "description": "AffixIO Node.js SDK. Know Your Agent (KYA) first, local ops dashboard, licence-only proving, HMAC/UltraHonk, ML-DSA-65, Merkle audit. Defaults to api.affix-io.com.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent-trust": {
      "types": "./dist/agent-trust/index.d.ts",
      "import": "./dist/agent-trust/index.js",
      "default": "./dist/agent-trust/index.js"
    }
  },
  "bin": {
    "affixio": "dist/cli.js",
    "affix-sdk": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "test": "npm run build && node --test test/smoke.test.mjs",
    "setup": "node dist/cli.js setup",
    "menu": "node dist/cli.js menu"
  },
  "keywords": [
    "affix",
    "affixio",
    "know-your-agent",
    "kya",
    "agentic-payments",
    "ai-payments",
    "ai-checkout",
    "agentic-commerce",
    "ai-shopping-agents",
    "agent-payments",
    "payment-mandates",
    "x402",
    "ap2",
    "mcp-tools",
    "autonomous-purchasing",
    "spending-limits",
    "agent-checkout",
    "machine-payments",
    "paid-api",
    "agent-trust",
    "sdk",
    "local-ops-dashboard",
    "enterprise",
    "ai-agent-governance",
    "agent-identity",
    "zero-knowledge",
    "zkp",
    "zk-proofs",
    "ultrahonk",
    "noir",
    "barretenberg",
    "post-quantum",
    "pqc",
    "ml-dsa",
    "ml-dsa-65",
    "fips-204",
    "dilithium",
    "attestation",
    "merkle",
    "merkle-tree",
    "privacy-preserving",
    "verifiable-credentials",
    "compliance",
    "crypto-agility",
    "offline-first",
    "pluggable-storage",
    "qr-code",
    "barcode",
    "data-check",
    "audit-trail",
