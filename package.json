{
  "name": "affixio",
  "version": "2.0.3",
  "description": "AffixIO: local proofs, ML-DSA-65 signatures, durable decision workflows, spending budgets, human review and portable evidence. Integration adapters for agent tools and payment authorization.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent-trust": {
      "types": "./dist/agent-trust/index.d.ts",
      "import": "./dist/agent-trust/index.js",
      "default": "./dist/agent-trust/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js",
      "default": "./dist/extensions/index.js"
    },
    "./sth": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js",
      "default": "./dist/extensions/index.js"
    },
    "./offline": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js",
      "default": "./dist/extensions/index.js"
    },
    "./workflows": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./browser": {
      "types": "./dist/runtime/browser.d.ts",
      "import": "./dist/runtime/browser.js",
      "default": "./dist/runtime/browser.js"
    }
  },
  "bin": {
    "affixio": "dist/cli.js",
    "affix-sdk": "dist/cli.js",
    "affix-sdk-ext": "dist/cli-ext.js",
    "affixio-evidence": "dist/runtime/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:python": "python3 -m unittest discover -s python/tests",
    "test:package": "node scripts/package-check.mjs",
    "prepack": "npm run build && npm test && npm run test:types",
    "setup": "node dist/cli.js setup",
    "menu": "node dist/cli.js menu",
    "build:features": "node scripts/build.mjs",
    "test:features": "node --test tests/*.test.mjs",
    "doctor": "node dist/cli-ext.js doctor"
  },
