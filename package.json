  "license": "Apache-2.0",
  "homepage": "https://www.affix-io.com/agent-trust/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AffixIO/SDK.git"
  },
  "bugs": {
    "url": "https://github.com/AffixIO/SDK/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "circuits",
    "certs",
    "demo-data",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260601",
    "@noble/post-quantum": "^0.4.1",
    "@noir-lang/noir_js": "1.0.0-beta.22",
    "bwip-js": "^4.5.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
