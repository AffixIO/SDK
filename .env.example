# Template only -- this file is not loaded by the SDK and the sample value is not a key.
# The SDK reads AFFIX_API_KEY from the environment, or from .affix/secrets/api.key
# (recommended: `npx affix-sdk set-key --api-key aio_live_...`).
# Keys are issued at https://hub.affix-io.com/ -- keep them out of git.

AFFIX_API_KEY=aio_live_your_key_here
AFFIX_API_BASE=https://api.affix-io.com
